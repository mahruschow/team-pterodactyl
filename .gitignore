# KiCad local editor state and locks
*.kicad_prl
*.lck
*.kicad_pcb.lck
*.kicad_sch.lck
*-backups/
*.kicad_sch-bak
*.kicad_pcb-bak

# OS and import artifacts
.DS_Store
._*
__MACOSX/
.history/

# Generated outputs belong in a reviewed release, not the working source tree
*.gbr
*.drl
*.pos
*.rpt~

# Local working checkpoints, downloaded references and Python caches
/work/
__pycache__/
*.pyc

# Reviewed P1 fabrication evidence includes the audited drill files
!docs/validation/2026-10-21/first-prototype-release/fabrication/*.drl
